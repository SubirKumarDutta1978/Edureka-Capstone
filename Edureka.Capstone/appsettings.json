{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Capstone": {
    "ApplicationName": "Edureka Capstone - Enterprise Document Assistant",
    "UploadFolder": "Data\\Uploads",
    "MaxFileSizeMb": 50,
    "SupportedExtensions": [ ".pdf", ".txt", ".csv", ".xlsx", ".xls" ],
    "Llm": {
      "Provider": "OpenAI",
      "Model": "gpt-4o-mini",
      "ApiKey": ""
    },
    "Embedding": {
      "Provider": "OpenAI",
      "Model": "text-embedding-3-small"
    },
    "VectorStore": {
      "Provider": "InMemory",
      "Path": "Data\\VectorStore"
    }
  }
}
